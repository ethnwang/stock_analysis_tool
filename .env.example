# Required for news/sentiment analysis (free at https://finnhub.io)
FINNHUB_API_KEY=your_key_here

# Analysis settings
UNIVERSE=watchlist              # sp500 | watchlist
TOP_N=10                        # Number of top picks to show
LOOKBACK_DAYS=420               # Price history window in days (~290 trading bars, needed for 12-1 momentum)

# Scoring weights (must sum to 1.0)
WEIGHT_TECHNICAL=0.45
WEIGHT_FUNDAMENTAL=0.45
WEIGHT_SENTIMENT=0.10

# Risk profile: aggressive | moderate | conservative
RISK_PROFILE=moderate
SENTIMENT_BACKEND=lexicon        # lexicon | finbert (needs: pip3 install torch --index-url https://download.pytorch.org/whl/cpu && pip3 install transformers)

# Filters
MIN_PRICE=5.0
MIN_MARKET_CAP=300000000        # $300M minimum market cap

# Schwab API (https://developer.schwab.com)
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REFRESH_TOKEN=

# Plaid API (https://plaid.com/docs — first 200 calls free)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_ACCESS_TOKEN_CHASE=
PLAID_ACCESS_TOKEN_FIDELITY=
